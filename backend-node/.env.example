# Ambiente
NODE_ENV=development
PORT=3001

# Neon/PostgreSQL. Em produção use a connection string "pooled" do Neon.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# Gere um segredo longo e aleatório para produção.
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Origens permitidas, separadas por vírgula. Use * apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:5173

# Integração opcional com o microsserviço Spring Boot.
# Sem URL (ou se ele estiver indisponível), a API usa a mesma fórmula localmente.
CALCULATOR_SERVICE_URL=http://localhost:8080
CALCULATOR_TIMEOUT_MS=3000
CALCULATOR_STRICT=false

# Usado pelo script `npm run create:admin`.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@lojap3d.local
ADMIN_PASSWORD=05051320
