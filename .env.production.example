# .env.example - Variáveis de ambiente para produção
# Copie para .env e preencha os valores reais

# ===========================================
# BACKEND NODE.JS (API Principal)
# ===========================================
NODE_ENV=production
PORT=3001

# Banco de dados PostgreSQL (Neon/Railway/Supabase)
DATABASE_URL=postgresql://usuario:senha@host:5432/printforge?sslmode=require
DATABASE_SSL=true

# JWT
JWT_SECRET=sua_chave_secreta_super_secreta_com_64_caracteres_minimo
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=https://printforge-3d.vercel.app

# Calculadora Java (Spring Boot)
CALCULATOR_SERVICE_URL=https://calculator.seu-dominio.com
CALCULATOR_TIMEOUT_MS=3000
CALCULATOR_STRICT=false

# ===========================================
# BACKEND JAVA (Calculadora Spring Boot)
# ===========================================
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://printforge-3d.vercel.app,http://localhost:3000
SPRING_PROFILES_ACTIVE=production

# ===========================================
# FRONTEND (Vercel)
# ===========================================
VITE_API_URL=https://api.seu-dominio.com/api

# ===========================================
# BANCO DE DADOS (PostgreSQL - Neon/Railway/Supabase)
# ===========================================
# DATABASE_URL=postgresql://usuario:senha@host:5432/printforge?sslmode=require
# DATABASE_SSL=true

# ===========================================
# JWT
# ===========================================
# JWT_SECRET=gere_uma_chave_com_64_caracteres_aleatorios
# JWT_EXPIRES_IN=8h

# ===========================================
# FRONTEND (Vercel)
# ===========================================
VITE_API_URL=https://api.seu-dominio.com/api

# ===========================================
# DOCKER
# ===========================================
DB_PASSWORD=sua_senha_postgres_forte
JWT_SECRET=sua_chave_jwt_super_secreta_64_chars
DB_PASSWORD=sua_senha_postgres_forte

# ===========================================
# RAILWAY/RENDER/FLY.IO VARIÁVEIS
# ===========================================
# NODE_ENV=production
# SPRING_PROFILES_ACTIVE=production
# DATABASE_URL=postgresql://...
# JWT_SECRET=...
# CORS_ORIGIN=https://printforge-3d.vercel.app